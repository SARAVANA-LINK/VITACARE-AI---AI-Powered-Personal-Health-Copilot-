# ==============================================================================
# VitaCare AI - Production Environment Configuration Template
# ==============================================================================

# Application & API
PROJECT_NAME="VitaCare AI Health Platform"
VERSION="1.0.0"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# Security & Tokens (Generate secure 256-bit key in production)
SECRET_KEY="vitacare_production_master_secret_key_2026_super_secure_clinical_jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://vitacare_user:vitacare_secure_pass@localhost:5432/vitacare_db"

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# S3 Private Object Storage (AWS S3 / MinIO / Cloudflare R2)
STORAGE_TYPE="local" # "s3" or "local"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="vitacare-medical-docs"
LOCAL_STORAGE_DIR="./uploads"

# AI Provider Integration
# Supported: "gemini", "openai", "anthropic", "local_rag"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Phone OTP / SMS Provider
# Supported: "mock", "twilio", "fast2sms"
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Email Notifications
# Supported: "console", "smtp", "sendgrid"
EMAIL_PROVIDER="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
